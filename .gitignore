# Claude Code local tooling (permissions/settings, not project source)
.claude/

# Generated plots from offline_fit_physics_analysis.py -- regenerate locally, never
# committed (see docs/virtual-shifting/experiments/10-offline-fit-physics-analysis.md)
docs/virtual-shifting/experiments/10-*.png

# Raw FIT ride files and route JSON generated by fit_to_route_json.py -- personal
# GPS/location data, kept local only (see docs/virtual-shifting/experiments/fit_to_route_json.py)
*.fit
docs/virtual-shifting/experiments/*-route.json
# Exception: experiment 17's route is SYNTHETIC -- generated by make_sweep_route.py from a
# plateau table, origin pinned at (0,0), no recorded ride anywhere in it. The reason for the
# rule above (personal location data) does not apply, and the protocol is unreproducible
# without it.
!docs/virtual-shifting/experiments/17-crr-cw-sweep-route.json

# Raw BLE captures from tools/ble-lab/ -- personal Bluetooth traffic, and large.
# MANIFESTS ARE COMMITTED, pcaps are not: a manifest records hardware, firmware,
# scenario, environment and every action marker, which is enough to interpret an
# analysis later and to know what to re-capture. See tools/ble-lab/README.md.
captures/*
!captures/.gitkeep
!captures/*.manifest.json
*.pklg
*.pcap
*.pcapng
btsnoop_hci.log
__pycache__/
*.pyc

# Python venv for offline FIT analysis (fitparse/numpy/scipy) — see
# docs/virtual-shifting/experiments/offline_fit_physics_analysis.py
.venv-fit/
